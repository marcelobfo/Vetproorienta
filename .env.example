# GEMINI_API_KEY: Required for Gemini AI API calls (Server-side secret)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://vetproorienta.technedigital.com.br"
NEXT_PUBLIC_APP_URL="https://vetproorienta.technedigital.com.br"

# Supabase (Configurações do Banco & Auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Evolution API WhatsApp (Server-side secrets - NUNCA use NEXT_PUBLIC_ aqui)
EVOLUTION_SERVER_URL=
EVOLUTION_API_KEY=
EVOLUTION_DEFAULT_INSTANCE=vetpro-clinica

# Asaas Gateway de Pagamentos (Server-side secrets)
ASAAS_API_KEY=
ASAAS_WEBHOOK_AUTH_TOKEN=
# ASAAS_ENVIRONMENT: 'sandbox' para testes (sandbox.asaas.com) ou 'production' para produção real
ASAAS_ENVIRONMENT=sandbox
# ASAAS_BASE_URL=https://api-sandbox.asaas.com

